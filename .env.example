# Model connections can be configured in the WebUI Settings page.
# Copy to .env for optional server settings. Never commit real credentials.
# Relative data paths are resolved from the repository root.
MEMORY_DATA_DIR=.data
AGENT_HOST=127.0.0.1
AGENT_PORT=4310
AGENT_ORIGIN=http://127.0.0.1:4310

# Optional initial model defaults; WebUI-saved settings take precedence.
# OpenAI-compatible provider: configure all three values to enable it.
MEMORY_OPENAI_BASE_URL=https://api.openai.com/v1
MEMORY_OPENAI_MODEL=
MEMORY_OPENAI_API_KEY=
# Set true only when the selected model/endpoint supports images.
MEMORY_OPENAI_VISION=false

# Anthropic-compatible provider (optional).
MEMORY_ANTHROPIC_BASE_URL=https://api.anthropic.com
MEMORY_ANTHROPIC_MODEL=
MEMORY_ANTHROPIC_API_KEY=
MEMORY_ANTHROPIC_VISION=false

# Comma-separated origins allowed to send browser requests to the API.
MEMORY_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Maximum upload size per file in bytes (default 1 GiB).
MEMORY_UPLOAD_LIMIT=1073741824
